generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  id                    String              @id @default(uuid()) @db.Char(36)
  auth0Sub              String              @unique @map("auth0_sub")
  email                 String?
  name                  String?
  picture               String?
  isInDb                Boolean             @default(false) @map("is_in_db")
  isFirstLogin          Boolean             @default(true) @map("is_first_login")
  
  // Subscription fields
  subscriptionPlan      SubscriptionPlan    @default(free) @map("subscription_plan")
  subscriptionStartDate DateTime?           @map("subscription_start_date")
  subscriptionEndDate   DateTime?           @map("subscription_end_date")
  
  createdAt             DateTime            @default(now()) @map("created_at")
  updatedAt             DateTime            @updatedAt @map("updated_at")
  invitedAccountMembers AccountMember[]     @relation("AccountMemberInviter")
  accountMembers        AccountMember[]     @relation("AccountMemberUser")
  ownedAccounts         Account[]           @relation("AccountOwner")
  auditLogs             AuditLog[]
  createdBudgetTxns     BudgetTransaction[] @relation("BudgetTransactionCreator")
  createdBudgets        Budget[]            @relation("BudgetCreator")
  createdCards          Card[]              @relation("CardCreator")
  assignedCards         Card[]              @relation("CardAssignee")
  createdContacts       Contact[]           @relation("ContactCreator")
  createdGifts          Gift[]              @relation("GiftCreator")
  assignedGifts         Gift[]              @relation("GiftAssignee")
  createdGuestLists     GuestList[]         @relation("GuestListCreator")
  createdHolidays       Holiday[]           @relation("HolidayCreator")
  sentInvites           Invite[]            @relation("InviteSender")
  receivedInvites       Invite[]            @relation("InviteReceiver")
  invitedByShares       ShareMember[]       @relation("ShareMemberInvitedBy")
  shareMemberships      ShareMember[]       @relation("ShareMemberUser")
  ownedShares           Share[]             @relation("ShareOwner")
  assignedByTasks       TaskAssignee[]      @relation("TaskAssignmentBy")
  taskAssignments       TaskAssignee[]      @relation("TaskAssignmentUser")
  assignedTasks         Task[]              @relation("TaskAssignee")
  createdTasks          Task[]              @relation("TaskCreator")
  notifications         Notification[]      @relation("UserNotifications")
  sentNotifications     Notification[]      @relation("NotificationSender")
  notificationPrefs     NotificationPreferences?
  preferences           UserPreferences?

  @@index([email])
  @@map("users")
}

model UserPreferences {
  id                     String   @id @default(uuid()) @db.Char(36)
  userId                 String   @unique @map("user_id") @db.Char(36)
  theme                  String   @default("system")
  displayMode            String   @default("professional")
  showCompletedItems     Boolean  @default(true) @map("show_completed_items")
  showCountdown          Boolean  @default(true) @map("show_countdown")
  showProgressBars       Boolean  @default(true) @map("show_progress_bars")
  emailNotifications     Boolean  @default(true) @map("email_notifications")
  pushNotifications      Boolean  @default(true) @map("push_notifications")
  reminderNotifications  Boolean  @default(true) @map("reminder_notifications")
  taskDueReminders       Boolean  @default(true) @map("task_due_reminders")
  holidayCountdownAlerts Boolean  @default(true) @map("holiday_countdown_alerts")
  timezone               String   @default("UTC")
  locale                 String   @default("en-US")
  reducedMotion          Boolean  @default(false) @map("reduced_motion")
  highContrast           Boolean  @default(false) @map("high_contrast")
  fontSize               String   @default("medium") @map("font_size")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")
  user                   User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("user_preferences")
}

model Account {
  id          String          @id @default(uuid()) @db.Char(36)
  name        String
  ownerUserId String          @map("owner_user_id") @db.Char(36)
  createdAt   DateTime        @default(now()) @map("created_at")
  updatedAt   DateTime        @updatedAt @map("updated_at")
  members     AccountMember[]
  owner       User            @relation("AccountOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  auditLogs   AuditLog[]
  contacts    Contact[]
  holidays    Holiday[]

  @@index([ownerUserId])
  @@map("accounts")
}

model AccountMember {
  accountId String     @map("account_id") @db.Char(36)
  userId    String     @map("user_id") @db.Char(36)
  role      MemberRole
  invitedBy String?    @map("invited_by") @db.Char(36)
  createdAt DateTime   @default(now()) @map("created_at")
  account   Account    @relation(fields: [accountId], references: [id], onDelete: Cascade)
  inviter   User?      @relation("AccountMemberInviter", fields: [invitedBy], references: [id])
  user      User       @relation("AccountMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([accountId, userId])
  @@index([userId])
  @@index([accountId])
  @@index([invitedBy], map: "account_members_invited_by_fkey")
  @@map("account_members")
}

model Holiday {
  id                String             @id @default(uuid()) @db.Char(36)
  accountId         String             @map("account_id") @db.Char(36)
  holidayType       String             @map("holiday_type")
  name              String
  description       String?
  startDate         DateTime           @map("start_date") @db.Date
  endDate           DateTime?          @map("end_date") @db.Date
  countdownTimer    DateTime?          @map("countdown_timer")
  colorLight        String             @map("color_light")
  colorDark         String             @map("color_dark")
  isCustom          Boolean            @default(false) @map("is_custom")
  createdBy         String             @map("created_by") @db.Char(36)
  createdAt         DateTime           @default(now()) @map("created_at")
  updatedAt         DateTime           @updatedAt @map("updated_at")
  budgets           Budget[]
  cards             Card[]
  gifts             Gift[]
  guestLists        GuestList[]
  account           Account            @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creator           User               @relation("HolidayCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  kwanzaaPrinciples KwanzaaPrinciple[]
  notifications     Notification[]
  shares            Share?
  tasks             Task[]

  @@unique([accountId, holidayType], name: "unique_account_holiday_type")
  @@index([accountId, holidayType])
  @@index([startDate])
  @@index([isCustom])
  @@index([createdBy], map: "holidays_created_by_fkey")
  @@map("holidays")
}

model Contact {
  id            String      @id @default(uuid()) @db.Char(36)
  accountId     String      @map("account_id") @db.Char(36)
  name          String
  email         String?
  phone         String?
  streetAddress String?     @map("street_address")
  city          String?
  state         String?
  postalCode    String?     @map("postal_code")
  relationship  String?
  notes         String?
  createdBy     String      @map("created_by") @db.Char(36)
  createdAt     DateTime    @default(now()) @map("created_at")
  updatedAt     DateTime    @updatedAt @map("updated_at")
  cards         Card[]
  account       Account     @relation(fields: [accountId], references: [id], onDelete: Cascade)
  creator       User        @relation("ContactCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  gifts         Gift[]
  guestLists    GuestList[]

  @@unique([accountId, email])
  @@index([accountId])
  @@index([name])
  @@index([email])
  @@index([createdBy], map: "contacts_created_by_fkey")
  @@map("contacts")
}

model Task {
  id            String         @id @default(uuid()) @db.Char(36)
  holidayId     String         @map("holiday_id") @db.Char(36)
  title         String
  description   String?
  priority      TaskPriority   @default(low)
  category      String?
  isCompleted   Boolean        @default(false) @map("is_completed")
  completedDate DateTime?      @map("completed_date")
  dueDate       DateTime?      @map("due_date") @db.Date
  assignedTo    String?        @map("assigned_to") @db.Char(36)
  createdBy     String         @map("created_by") @db.Char(36)
  shareId       String?        @map("share_id") @db.Char(36)
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")
  taskAssignees TaskAssignee[]
  assignee      User?          @relation("TaskAssignee", fields: [assignedTo], references: [id])
  creator       User           @relation("TaskCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  holiday       Holiday        @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  share         Share?         @relation(fields: [shareId], references: [id])

  @@index([holidayId])
  @@index([assignedTo])
  @@index([isCompleted])
  @@index([dueDate])
  @@index([createdBy], map: "tasks_created_by_fkey")
  @@index([shareId], map: "tasks_share_id_fkey")
  @@map("tasks")
}

model TaskAssignee {
  taskId     String   @map("task_id") @db.Char(36)
  userId     String   @map("user_id") @db.Char(36)
  assignedAt DateTime @default(now()) @map("assigned_at")
  assignedBy String   @map("assigned_by") @db.Char(36)
  assigner   User     @relation("TaskAssignmentBy", fields: [assignedBy], references: [id], onDelete: Cascade)
  task       Task     @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user       User     @relation("TaskAssignmentUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([taskId, userId])
  @@index([userId])
  @@index([assignedBy], map: "task_assignees_assigned_by_fkey")
  @@map("task_assignees")
}

model Gift {
  id            String    @id @default(uuid()) @db.Char(36)
  holidayId     String    @map("holiday_id") @db.Char(36)
  contactId     String?   @map("contact_id") @db.Char(36)
  name          String
  description   String?
  price         Decimal   @db.Decimal(12, 2)
  actualPrice   Decimal?  @map("actual_price") @db.Decimal(12, 2)
  store         String?
  productLink   String?   @map("product_link")
  notes         String?
  isCompleted   Boolean   @default(false) @map("is_completed")
  completedDate DateTime? @map("completed_date")
  assignedTo    String?   @map("assigned_to") @db.Char(36)
  createdBy     String    @map("created_by") @db.Char(36)
  shareId       String?   @map("share_id") @db.Char(36)
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")
  contact       Contact?  @relation(fields: [contactId], references: [id])
  assignedUser  User?     @relation("GiftAssignee", fields: [assignedTo], references: [id])
  creator       User      @relation("GiftCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  holiday       Holiday   @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  share         Share?    @relation(fields: [shareId], references: [id])

  @@index([holidayId])
  @@index([contactId])
  @@index([isCompleted])
  @@index([assignedTo])
  @@index([price])
  @@index([createdBy], map: "gifts_created_by_fkey")
  @@index([shareId], map: "gifts_share_id_fkey")
  @@map("gifts")
}

model Card {
  id          String    @id @default(uuid()) @db.Char(36)
  holidayId   String    @map("holiday_id") @db.Char(36)
  contactId   String?   @map("contact_id") @db.Char(36)
  recipient   String
  address     String?
  message     String
  isCompleted Boolean   @default(false) @map("is_completed")
  sentDate    DateTime? @map("sent_date")
  assignedTo  String?   @map("assigned_to") @db.Char(36)
  createdBy   String    @map("created_by") @db.Char(36)
  shareId     String?   @map("share_id") @db.Char(36)
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  contact      Contact?  @relation(fields: [contactId], references: [id])
  assignedUser User?     @relation("CardAssignee", fields: [assignedTo], references: [id])
  creator      User      @relation("CardCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  holiday      Holiday   @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  share        Share?    @relation(fields: [shareId], references: [id])

  @@index([holidayId])
  @@index([contactId])
  @@index([isCompleted])
  @@index([assignedTo])
  @@index([createdBy], map: "cards_created_by_fkey")
  @@index([shareId], map: "cards_share_id_fkey")
  @@map("cards")
}

model Budget {
  id              String              @id @default(uuid()) @db.Char(36)
  holidayId       String              @map("holiday_id") @db.Char(36)
  name            String
  totalBudget     Decimal             @map("total_budget") @db.Decimal(12, 2)
  spentAmount     Decimal             @default(0.00) @map("spent_amount") @db.Decimal(12, 2)
  remainingAmount Decimal             @default(0.00) @map("remaining_amount") @db.Decimal(12, 2)
  currency        String
  startDate       DateTime            @map("start_date") @db.Date
  endDate         DateTime            @map("end_date") @db.Date
  createdBy       String              @map("created_by") @db.Char(36)
  createdAt       DateTime            @default(now()) @map("created_at")
  updatedAt       DateTime            @updatedAt @map("updated_at")
  transactions    BudgetTransaction[]
  creator         User                @relation("BudgetCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  holiday         Holiday             @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@index([holidayId])
  @@index([startDate, endDate])
  @@index([createdBy], map: "budgets_created_by_fkey")
  @@map("budgets")
}

model BudgetTransaction {
  id              String   @id @default(uuid()) @db.Char(36)
  budgetId        String   @map("budget_id") @db.Char(36)
  name            String
  description     String?
  amount          Decimal  @db.Decimal(12, 2)
  category        String
  transactionDate DateTime @map("transaction_date") @db.Date
  isExpense       Boolean  @default(true) @map("is_expense")
  createdBy       String   @map("created_by") @db.Char(36)
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")
  budget          Budget   @relation(fields: [budgetId], references: [id], onDelete: Cascade)
  creator         User     @relation("BudgetTransactionCreator", fields: [createdBy], references: [id], onDelete: Cascade)

  @@index([budgetId])
  @@index([category])
  @@index([transactionDate])
  @@index([createdBy], map: "budget_transactions_created_by_fkey")
  @@map("budget_transactions")
}

model Share {
  id          String        @id @default(uuid()) @db.Char(36)
  holidayId   String        @unique @map("holiday_id") @db.Char(36)
  ownerUserId String        @map("owner_user_id") @db.Char(36)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")
  cards       Card[]
  gifts       Gift[]
  invites     Invite[]
  members     ShareMember[]
  holiday     Holiday       @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  owner       User          @relation("ShareOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  tasks       Task[]

  @@index([ownerUserId])
  @@map("shares")
}

model ShareMember {
  shareId   String   @map("share_id") @db.Char(36)
  userId    String   @map("user_id") @db.Char(36)
  joinedAt  DateTime @default(now()) @map("joined_at")
  invitedBy String?  @map("invited_by") @db.Char(36)
  inviter   User?    @relation("ShareMemberInvitedBy", fields: [invitedBy], references: [id])
  share     Share    @relation(fields: [shareId], references: [id], onDelete: Cascade)
  user      User     @relation("ShareMemberUser", fields: [userId], references: [id], onDelete: Cascade)

  @@id([shareId, userId])
  @@index([userId])
  @@index([shareId])
  @@index([invitedBy], map: "share_members_invited_by_fkey")
  @@map("share_members")
}

model Invite {
  id                String       @id @default(uuid()) @db.Char(36)
  shareId           String       @map("share_id") @db.Char(36)
  fromUserId        String       @map("from_user_id") @db.Char(36)
  toUserId          String?      @map("to_user_id") @db.Char(36)
  toEmail           String?
  holidayKey        String       @map("holiday_key")
  status            InviteStatus
  message           String?
  respondedAt       DateTime?    @map("responded_at")
  createdAt         DateTime     @default(now()) @map("created_at")
  senderDismissedAt DateTime?    @map("sender_dismissed_at")
  fromUser          User         @relation("InviteSender", fields: [fromUserId], references: [id], onDelete: Cascade)
  share             Share        @relation(fields: [shareId], references: [id], onDelete: Cascade)
  toUser            User?        @relation("InviteReceiver", fields: [toUserId], references: [id])
  notifications     Notification[]

  @@index([toEmail])
  @@index([status])
  @@index([shareId])
  @@index([fromUserId], map: "invites_from_user_id_fkey")
  @@index([toUserId], map: "invites_to_user_id_fkey")
  @@map("invites")
}

model KwanzaaPrinciple {
  id          String    @id @default(uuid()) @db.Char(36)
  holidayId   String    @map("holiday_id") @db.Char(36)
  dayNumber   Int       @map("day_number")
  name        String
  description String?
  isCompleted Boolean   @default(false) @map("is_completed")
  completedAt DateTime? @map("completed_at")
  notes       String?
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  holiday     Holiday   @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([holidayId, dayNumber])
  @@index([isCompleted])
  @@map("kwanzaa_principles")
}

model GuestList {
  id         String      @id @default(uuid()) @db.Char(36)
  holidayId  String      @map("holiday_id") @db.Char(36)
  contactId  String      @map("contact_id") @db.Char(36)
  rsvpStatus RSVPStatus? @map("rsvp_status")
  rsvpDate   DateTime?   @map("rsvp_date")
  notes      String?
  createdBy  String      @map("created_by") @db.Char(36)
  createdAt  DateTime    @default(now()) @map("created_at")
  updatedAt  DateTime    @updatedAt @map("updated_at")
  contact    Contact     @relation(fields: [contactId], references: [id], onDelete: Cascade)
  creator    User        @relation("GuestListCreator", fields: [createdBy], references: [id], onDelete: Cascade)
  holiday    Holiday     @relation(fields: [holidayId], references: [id], onDelete: Cascade)

  @@unique([holidayId, contactId])
  @@index([rsvpStatus])
  @@index([contactId], map: "guest_lists_contact_id_fkey")
  @@index([createdBy], map: "guest_lists_created_by_fkey")
  @@map("guest_lists")
}

model AuditLog {
  id         String   @id @default(uuid()) @db.Char(36)
  accountId  String   @map("account_id") @db.Char(36)
  userId     String?  @map("user_id") @db.Char(36)
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id") @db.Char(36)
  details    Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")
  account    Account  @relation(fields: [accountId], references: [id], onDelete: Cascade)
  user       User?    @relation(fields: [userId], references: [id])

  @@index([accountId, createdAt])
  @@index([userId, createdAt])
  @@index([entityType, entityId])
  @@index([createdAt])
  @@map("audit_log")
}

model Notification {
  id           String    @id @default(uuid()) @db.Char(36)
  userId       String    @map("user_id") @db.Char(36)
  type         String    @db.VarChar(50)
  title        String    @db.VarChar(255)
  message      String?   @db.Text
  entityType   String?   @map("entity_type") @db.VarChar(50)
  entityId     String?   @map("entity_id") @db.Char(36)
  holidayId    String?   @map("holiday_id") @db.Char(36)
  fromUserId   String?   @map("from_user_id") @db.Char(36)
  inviteId     String?   @map("invite_id") @db.Char(36)
  isRead       Boolean   @default(false) @map("is_read")
  isDismissed  Boolean   @default(false) @map("is_dismissed")
  readAt       DateTime? @map("read_at")
  dismissedAt  DateTime? @map("dismissed_at")
  createdAt    DateTime  @default(now()) @map("created_at")
  user         User      @relation("UserNotifications", fields: [userId], references: [id], onDelete: Cascade)
  fromUser     User?     @relation("NotificationSender", fields: [fromUserId], references: [id], onDelete: SetNull)
  holiday      Holiday?  @relation(fields: [holidayId], references: [id], onDelete: Cascade)
  invite       Invite?   @relation(fields: [inviteId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
  @@index([userId, type])
  @@index([createdAt])
  @@map("notifications")
}

model NotificationPreferences {
  id                      String   @id @default(uuid()) @db.Char(36)
  userId                  String   @unique @map("user_id") @db.Char(36)
  assignmentNotifications Boolean  @default(true) @map("assignment_notifications")
  completionNotifications Boolean  @default(true) @map("completion_notifications")
  inviteNotifications     Boolean  @default(true) @map("invite_notifications")
  emailNotifications      Boolean  @default(false) @map("email_notifications")
  digestFrequency         String   @default("immediate") @map("digest_frequency") @db.VarChar(20)
  createdAt               DateTime @default(now()) @map("created_at")
  updatedAt               DateTime @updatedAt @map("updated_at")
  user                    User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("notification_preferences")
}

enum TaskPriority {
  low
  medium
  high
}

enum InviteStatus {
  pending
  accepted
  declined
  expired
}

enum RSVPStatus {
  pending
  confirmed
  declined
  maybe
}

enum MemberRole {
  owner
  admin
  member
}

enum SubscriptionPlan {
  free
  plus
}
