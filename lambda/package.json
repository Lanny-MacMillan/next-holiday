{
  "name": "next-holiday-lambda",
  "version": "1.0.0",
  "description": "AWS Lambda function for Next Holiday API",
  "main": "handler.js",
  "scripts": {
    "build": "tsc",
    "package": "npm run build && zip -r function.zip dist/ node_modules/",
    "deploy": "aws lambda update-function-code --function-name next-holiday-api --zip-file fileb://function.zip",
    "test": "jest"
  },
  "dependencies": {
    "@prisma/client": "^6.14.0",
    "@auth0/nextjs-auth0": "^3.5.0",
    "jsonwebtoken": "^9.0.2",
    "jwks-client": "^3.0.1",
    "uuid": "^10.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.130",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.0",
    "@types/uuid": "^10.0.0",
    "prisma": "^6.14.0",
    "typescript": "^5.3.0",
    "jest": "^29.7.0",
    "@types/jest": "^29.5.8"
  },
  "prisma": {
    "schema": "../prisma/schema.prisma",
    "seed": "ts-node ../prisma/seed.ts"
  }
}
